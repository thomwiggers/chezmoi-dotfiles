CanonicalizeHostname yes
CanonicalDomains incus ide-nessie.ts.net

# For tab completion
HashKnownHosts no

Host *
  AddKeysToAgent yes
  ControlMaster auto
  ControlPersist yes
  ControlPath ~/.ssh/sockets/%C
  TCPKeepAlive yes
  ServerAliveInterval 20

Host github.com
  ControlPersist no
  ControlMaster no

  # Ephemeral VMs reuse names with different host keys; network is the trust boundary.
Host *.ide-nessie.ts.net *.incus
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR

Host gitlab.pqsh.net
  Hostname 10.1.9.163
  Port 1223
  ProxyJump bastion01.pqsh.net

Host bastion01.pqsh.net
  Hostname 95.154.247.251
  Port 1323
  User jumpuser

Host cocytus
  Hostname cocytus.ide-nessie.ts.net
  ForwardAgent yes
  User thom
  RemoteForward /run/user/1000/gnupg/S.gpg-agent /Users/thom/.gnupg/S.gpg-agent.extra

Host eprint
  #Hostname eprint.iacr.org
  Hostname 64.227.104.178
  ForwardAgent False
  User wiggers


