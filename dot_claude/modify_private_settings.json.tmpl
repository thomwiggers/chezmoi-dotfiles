{{- /* Merge shared defaults into ~/.claude/settings.json without clobbering
       keys managed elsewhere (model, notification prefs, etc.).
       chezmoi passes the current file on stdin; stdout becomes the new file. */ -}}
#!/bin/bash
set -euo pipefail

{{ template "brew-shellenv.sh" . }}
input=$(cat)
if [ -z "$input" ]; then
  input='{}'
fi

defaults='{
  "permissions": {
    "defaultMode": {{ .claude.default_mode | quote }}
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "enableWorkflows": true,
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "sandbox": {
    "enabled": true
  },
  "outputStyle": "concise",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "theme": "auto",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": {{ if ne .claude.default_mode "default" }}true{{ else }}false{{ end }}
}'

allow='[
  "Bash(git add:*)",
  "Bash(git log:*)",
  "Bash(git status:*)"
]'

# The Xcode command-line-tool shims (/usr/bin/python3, /usr/bin/git, /usr/bin/make)
# write a lookup cache into the per-user temp dir; without write access there they
# print a warning on every invocation before handing off to the real binary.
# The path is derived from the account UUID, so resolve it at apply time instead
# of hardcoding it. Both /var/... and its /private/... realpath are listed
# because the sandbox matches on the resolved path.
sandbox_write='[]'
{{ if eq .chezmoi.os "darwin" -}}
user_tmp="$(getconf DARWIN_USER_TEMP_DIR)"
user_tmp="${user_tmp%/}"
if [ -n "$user_tmp" ]; then
  sandbox_write=$(jq -n --arg t "$user_tmp" '
    [$t] + (if ($t | startswith("/var/")) then ["/private" + $t] else [] end)
  ')
fi
{{- end }}

printf '%s\n' "$input" | jq \
  --argjson defaults "$defaults" \
  --argjson allow "$allow" \
  --argjson sandbox_write "$sandbox_write" '
  . * $defaults
  | .permissions.allow = (((.permissions.allow // []) + $allow) | unique)
  | if ($sandbox_write | length) > 0
    then .sandbox.allowWrite = (((.sandbox.allowWrite // []) + $sandbox_write) | unique)
    else . end
'
