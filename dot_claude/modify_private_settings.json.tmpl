{{- /* Merge shared defaults into ~/.claude/settings.json without clobbering
       keys managed elsewhere (model, notification prefs, etc.).
       chezmoi passes the current file on stdin; stdout becomes the new file. */ -}}
#!/bin/bash
set -euo pipefail

{{ template "brew-shellenv.sh" . }}
input=$(cat)
if [ -z "$input" ]; then
  input='{}'
fi

defaults='{
  "permissions": {
    "defaultMode": {{ .claude.default_mode | quote }}
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "enableWorkflows": true,
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowRead": [
        "~/.gitattributes",
        "~/.gitconfig",
        "~/.gitignore",
        "~/.local/share/chezmoi"
      ],
      "allowWrite": [
        "~/.local/share/chezmoi"
      ]
    }
  },
  "outputStyle": "concise",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "theme": "auto",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": {{ if ne .claude.default_mode "default" }}true{{ else }}false{{ end }}
}'

allow='[
  "Bash(git add:*)",
  "Bash(git log:*)",
  "Bash(git status:*)"
]'

printf '%s\n' "$input" | jq --argjson defaults "$defaults" --argjson allow "$allow" '
  . * $defaults
  # Older versions of this template wrote these to the wrong level; the
  # sandbox only reads sandbox.filesystem.allowRead/allowWrite.
  | del(.sandbox.allowRead, .sandbox.allowWrite)
  | .permissions.allow = (((.permissions.allow // []) + $allow) | unique)
'
