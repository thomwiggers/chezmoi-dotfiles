{{- $isDebian := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $isDebian = or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu") (contains "debian" (index .chezmoi.osRelease "idLike" | default "")) -}}
{{- end -}}
{{- if $isDebian -}}
#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

# On a freshly booted VM, cloud-init's own package_upgrade and the
# unattended-upgrades timer hold the dpkg lock; wait for it instead of dying.
apt_opts=(-o DPkg::Lock::Timeout=600 -o Acquire::Retries=3)

sudo apt-get "${apt_opts[@]}" update -qq
sudo apt-get "${apt_opts[@]}" install -y build-essential procps curl file git

{{ template "brew-install.sh" . }}
{{- end -}}
